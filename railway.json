# Railway Deployment Configuration
# This file is used by Railway to configure the service

# Build using the Dockerfile at repo root
# No additional config needed - Railway auto-detects Dockerfile

# Environment variables (set in Railway dashboard):
# VOICELENS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-preview-url.vercel.app
# VOICELENS_WHISPER_MODEL=base.en
# VOICELENS_MAX_FILE_SIZE=50000000
# VOICELENS_LOG_LEVEL=INFO

# Start command (from Dockerfile CMD):
# uvicorn voicelens.api.app:app --host 0.0.0.0 --port 8000 --workers 1

# Health check endpoint: /api/health
# Port: 8000